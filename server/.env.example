# =====================================================
# Astra Lens Server — Environment Variables
# Copy this file to .env and fill in all required values.
# =====================================================

# ─── SERVER ──────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ─── DATABASE (REQUIRED for credential storage + alerts) ──
# Get from: Neon/Supabase → Connection String
# If running a separate DB for Lens, use LENS_DATABASE_URL.
# Falls back to DATABASE_URL if LENS_DATABASE_URL is not set.
LENS_DATABASE_URL=postgresql://neondb_owner:npg_cZuBfH3Ce5Qi@ep-wild-frog-am1hhvsk-pooler.c-5.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lens?sslmode=require

# ─── CREDENTIAL ENCRYPTION (REQUIRED in production) ──
# AES-256-GCM key for encrypting stored Atlas/Spark API keys.
# REQUIRED. Generate with: openssl rand -hex 32
# Without this, credentials are stored with a default key (insecure).
CREDENTIALS_ENCRYPTION_KEY=

# ─── AI (REQUIRED — Groq, not Anthropic) ─────────────
# NOTE: The root .env.example lists ANTHROPIC_API_KEY but Lens uses GROQ.
# Get your key from: console.groq.com → API Keys
GROQ_API_KEY=

# ─── CORS ────────────────────────────────────────────
# The Lens web frontend URL
FRONTEND_URL=https://lens.astrastudio.in

# ─── DEFAULT TENANT (single-tenant / dev fallback) ───
# For single-tenant deployments or local dev, set these.
# In multi-tenant production, credentials are stored in the DB (see migrations/017).
ATLAS_API_URL=https://atlas.astrastudio.in
ATLAS_API_KEY=atlens1_...
SPARK_API_URL=https://api.spark.astrastudio.in
SPARK_API_KEY=splens1_...
SPARK_BUSINESS_ID=

# ─── CACHE TTL ───────────────────────────────────────
SNAPSHOT_CACHE_TTL=300
INSIGHTS_CACHE_TTL=600

# ─── SERVICE-TO-SERVICE AUTH ─────────────────────────
# Protects /api/internal/* routes (Atlas → Lens cache invalidation events).
# Must match LENS_SERVICE_KEY set in Atlas backend env.
# Generate with: openssl rand -hex 32
LENS_SERVICE_KEY=

# ─── ERROR TRACKING (optional but strongly recommended) ──
# Get from: sentry.io → Create Project → Node.js
SENTRY_DSN=

# ─── MOCK DATA (development only) ────────────────────
# IMPORTANT: Must be 'false' in production.
# Only activates mock data if BOTH DEV_MODE=true AND NODE_ENV != production.
DEV_MODE=false
